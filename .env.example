# A aplicação não exige segredos. Esta variável é opcional.
CONCILIACAO_LOG_LEVEL=INFO

# Limites seguros para extratos PDF
PDF_MAX_FILE_SIZE_MB=25
PDF_MAX_PAGES=100
PDF_EXTRACTION_TIMEOUT_SECONDS=120
PDF_OCR_LANGUAGE=por
# OCR é usado quando o PDF não possui texto pesquisável. Instale o idioma `por` no Tesseract.
# Não aponte TESSDATA_PREFIX para tmp/ do projeto; use a instalação do sistema ou um diretório externo.
PDF_OCR_COMMAND=tesseract
PDF_RENDER_COMMAND=pdftoppm

# Aplicação web pública — todos os limites mantêm estes padrões quando omitidos.
SESSION_TTL_SECONDS=7200
HEARTBEAT_GRACE_SECONDS=300
MAX_FILE_SIZE_MB=25
MAX_SESSION_SIZE_MB=75
MAX_STATEMENT_FILES=5
MAX_PDF_PAGES=100
MAX_ACTIVE_SESSIONS_PER_IP=1
MAX_SESSIONS_PER_HOUR=3
MAX_CONCURRENT_JOBS=2
MAX_QUEUED_JOBS=20

# Desenvolvimento local. Produção deve usar Redis e storage S3 compatível privado.
REDIS_URL=
STORAGE_MODE=local
LOCAL_STORAGE_PATH=.local-storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Só habilite TRUST_PROXY quando a borda remover cabeçalhos enviados pelo visitante.
TRUST_PROXY=false
IP_HASH_SALT=troque-em-producao
ANTIVIRUS_REQUIRED=false
ANTIVIRUS_COMMAND=clamscan
