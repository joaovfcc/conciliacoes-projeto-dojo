{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": false,
    "noEmit": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@conciliacao/core/presentation": ["../../packages/core/src/presentation.ts"],
      "@conciliacao/core/normalization": ["../../packages/core/src/normalization.ts"],
      "@conciliacao/core/bank-directory": ["../../packages/core/src/bank-directory.ts"]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
