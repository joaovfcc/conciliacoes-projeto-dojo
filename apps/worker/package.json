{
  "name": "@conciliacao/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "vitest run tests/unit",
    "lint": "eslint src tests --max-warnings=0"
  },
  "dependencies": {
    "@conciliacao/core": "workspace:*",
    "@conciliacao/runtime": "workspace:*",
    "bullmq": "^5.63.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "eslint": "^9.39.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
