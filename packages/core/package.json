{
  "name": "@conciliacao/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./presentation": {
      "types": "./src/presentation.ts",
      "import": "./dist/src/presentation.js",
      "default": "./dist/src/presentation.js"
    }
  },
  "scripts": {
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "auth:bootstrap-owner": "node scripts/bootstrap-owner.mjs",
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "vitest run tests/unit",
    "test:coverage": "vitest run --coverage.enabled true",
    "test:mutation": "stryker run stryker.config.mjs",
    "inventory:private-corpus": "node scripts/inventory-private-corpus.mjs",
    "lint": "eslint src tests --max-warnings=0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@node-rs/argon2": "2.0.2",
    "csv-parse": "^6.1.0",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "pdfjs-dist": "^5.4.624",
    "xlsx": "^0.18.5",
    "yauzl": "^3.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/yauzl": "^2.10.3",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "eslint": "^9.39.0",
    "fast-check": "4.5.3",
    "jszip": "^3.10.1",
    "prisma": "^5.22.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
