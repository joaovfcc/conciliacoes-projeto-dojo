generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ActiveStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OrganizationRole {
  OWNER
}

enum CompanyAccessRole {
  PREPARER
  REVIEWER
  ADMIN
  AUDITOR
}

enum AccountType {
  CHECKING
  SAVINGS
  INVESTMENT
  OTHER
}

enum ImportStatus {
  RECEIVED
  READING
  LAYOUT_DETECTED
  PARSING
  NEEDS_MAPPING
  PARSED_WITH_WARNINGS
  VALIDATED
  REJECTED
}

enum LayoutStatus {
  DRAFT
  ACTIVE
  DEPRECATED
}

enum ReconciliationStatus {
  PREPARING
  READY_FOR_REVIEW
  UNDER_REVIEW
  REJECTED
  APPROVED
  CLOSED
}

enum ExceptionStatus {
  OPEN
  ASSIGNED
  UNDER_REVIEW
  RESOLVED
  ACCEPTED_TIMING_DIFFERENCE
  REJECTED
}

enum ConfigProfileVersionStatus {
  DRAFT
  VALIDATING
  READY
  APPROVED
  PUBLISHED
  SUPERSEDED
  INACTIVE
}

enum ConfigImportMappingSource {
  BANK
  LEDGER
}

enum ConfigRoutingMatch {
  ALL
  ANY
}

enum ConfigInheritanceLevel {
  ORGANIZATION
  LEGAL_ENTITY
  PROFILE
  PROFILE_VERSION
}

enum ConfigEffectiveInheritanceLevel {
  GLOBAL
  BANK_LAYOUT
  LEGAL_ENTITY
  PROFILE
  PROFILE_VERSION
}

enum ConfigSimulationStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  TIMED_OUT
  CANCELLED
  BLOCKED
}

enum ConfigRunMode {
  DRAFT
  SIMULATION
  OFFICIAL
}

enum ConfigRunStatus {
  PREPARED
  PENDING
  RUNNING
  SUCCEEDED
  BLOCKED
  FAILED
  TIMED_OUT
  CANCELLED
}

model Company {
  id              String       @id @default(uuid())
  organizationId  String
  legalEntityId   String
  name            String
  documentNumber  String?
  status          ActiveStatus @default(ACTIVE)
  timezone        String       @default("America/Sao_Paulo")
  defaultCurrency String       @default("BRL")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  bankAccounts           BankAccount[]
  ledgerAccounts         LedgerAccount[]
  bankLedgerMappings     BankLedgerMapping[]
  reconciliationProfiles ReconciliationProfile[]
  dataSources            DataSource[]
  importBatches          ImportBatch[]
  reconciliationPeriods ReconciliationPeriod[]
  reconciliationRuns    ReconciliationRun[]
  completedReconciliations CompletedReconciliation[]
  companyAccesses        CompanyAccess[]
  transactions           NormalizedTransaction[]
  ledgerEntries          NormalizedLedgerEntry[]
  legalEntity            ConfigLegalEntity @relation(fields: [organizationId, legalEntityId], references: [organizationId, id], onDelete: Restrict)

  @@index([documentNumber])
  @@unique([organizationId, id])
  @@unique([organizationId, legalEntityId])
}

model CompanyAccess {
  id        String   @id @default(uuid())
  companyId String
  userId    String
  roles     CompanyAccessRole[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
}

model User {
  id                     String       @id @default(uuid())
  email                  String       @unique
  passwordHash           String
  status                 UserStatus   @default(ACTIVE)
  passwordChangeRequired Boolean      @default(true)
  authVersion            Int          @default(1)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  organizationMemberships OrganizationMembership[]
  companyAccesses         CompanyAccess[]
  authSessions            AuthSession[]
  completedReconciliations CompletedReconciliation[]

  @@index([status])
}

model OrganizationMembership {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  role           OrganizationRole
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization ConfigOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model AuthSession {
  id                String    @id @default(uuid())
  userId            String
  authVersion       Int
  createdAt         DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  idleExpiresAt     DateTime
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  revocationReason  String?

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens AuthRefreshToken[]

  @@index([userId, revokedAt])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
}

model AuthRefreshToken {
  id                String    @id @default(uuid())
  sessionId         String
  tokenHash         String    @unique
  expiresAt         DateTime
  createdAt         DateTime  @default(now())
  consumedAt        DateTime?
  revokedAt         DateTime?
  replacedByTokenId String?   @unique

  session     AuthSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacement AuthRefreshToken? @relation("RefreshRotation", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  previous    AuthRefreshToken? @relation("RefreshRotation")

  @@index([sessionId, expiresAt])
}

model BankAccount {
  id            String       @id @default(uuid())
  companyId     String
  bankCode      String?
  bankName      String?
  agency        String?
  accountNumber String?
  accountDigit  String?
  accountType   AccountType
  currency      String       @default("BRL")
  status        ActiveStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  company                Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  reconciliationProfiles ReconciliationProfile[]
  ledgerMappings         BankLedgerMapping[]
  layoutBindings          AccountLayoutBinding[]
  importBatches           ImportBatch[]
  transactions            NormalizedTransaction[]

  @@index([companyId, status])
  @@index([bankCode, agency, accountNumber])
}

model LedgerAccount {
  id           String       @id @default(uuid())
  companyId    String
  code         String
  description  String
  sourceSystem String
  status       ActiveStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  company      Company                              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  bankMappings BankLedgerMapping[]
  profileLinks ReconciliationProfileLedgerAccount[]
  entries      NormalizedLedgerEntry[]

  @@unique([companyId, code])
  @@index([companyId, status])
}

model BankLedgerMapping {
  id              String       @id @default(uuid())
  companyId       String
  bankAccountId   String
  ledgerAccountId String
  status          ActiveStatus @default(ACTIVE)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  bankAccount   BankAccount   @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  ledgerAccount LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  @@unique([bankAccountId, ledgerAccountId])
  @@index([companyId, status])
  @@index([bankAccountId, status])
  @@index([ledgerAccountId, status])
}

model ReconciliationProfile {
  id                   String       @id @default(uuid())
  companyId            String
  bankAccountId        String
  matchTypeId          String
  frequency            String
  riskLevel            String
  amountTolerance      Decimal      @db.Decimal(20, 2)
  dateToleranceDays    Int
  preparerId           String?
  reviewerIds          String[]
  materialityThreshold Decimal?     @db.Decimal(20, 2)
  status               ActiveStatus @default(ACTIVE)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  company        Company                              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  bankAccount    BankAccount                          @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  matchType      MatchType                            @relation(fields: [matchTypeId], references: [id], onDelete: Restrict)
  ledgerAccounts ReconciliationProfileLedgerAccount[]
  policies       ReconciliationPolicy[]
  runs           ReconciliationRun[]

  @@index([companyId, status])
  @@index([bankAccountId])
}

model ReconciliationProfileLedgerAccount {
  reconciliationProfileId String
  ledgerAccountId         String

  profile      ReconciliationProfile @relation(fields: [reconciliationProfileId], references: [id], onDelete: Cascade)
  ledgerAccount LedgerAccount         @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  @@id([reconciliationProfileId, ledgerAccountId])
}

model ReconciliationPolicy {
  id                             String   @id @default(uuid())
  reconciliationProfileId        String
  matchingStrategy               String
  dateToleranceDays              Int
  amountTolerance                Decimal  @db.Decimal(20, 2)
  allowOneToMany                 Boolean  @default(false)
  allowManyToOne                 Boolean  @default(false)
  allowManyToMany                Boolean  @default(false)
  descriptionSimilarityThreshold Float?
  materialityThreshold           Decimal? @db.Decimal(20, 2)
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  profile ReconciliationProfile @relation(fields: [reconciliationProfileId], references: [id], onDelete: Cascade)
}

model DataSource {
  id            String       @id @default(uuid())
  companyId     String?
  name          String
  type          String
  connectorType String
  status        ActiveStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  company       Company?      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  importBatches ImportBatch[]

  @@index([companyId, status])
}

model StatementLayout {
  id          String   @id @default(uuid())
  name        String
  bankCode    String?
  productType String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions LayoutVersion[]
}

model LayoutVersion {
  id               String       @id @default(uuid())
  layoutId         String
  version          Int
  status           LayoutStatus @default(DRAFT)
  formats          String[]
  detectionRules   Json
  columnMapping    Json
  parsingRules     Json
  fingerprint      Json
  fingerprintHash  String
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime     @default(now())

  layout        StatementLayout       @relation(fields: [layoutId], references: [id], onDelete: Restrict)
  bindings      AccountLayoutBinding[]
  importBatches ImportBatch[]

  @@unique([layoutId, version])
  @@index([fingerprintHash, status])
}

model AccountLayoutBinding {
  id              String       @id @default(uuid())
  bankAccountId   String
  layoutVersionId String
  priority        Int          @default(100)
  status          ActiveStatus @default(ACTIVE)
  customOverrides Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  bankAccount   BankAccount   @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  layoutVersion LayoutVersion @relation(fields: [layoutVersionId], references: [id], onDelete: Restrict)

  @@unique([bankAccountId, layoutVersionId])
  @@index([bankAccountId, status, priority])
}

model ImportBatch {
  id                             String       @id @default(uuid())
  companyId                      String
  bankAccountId                  String?
  dataSourceId                   String?
  layoutVersionId                String?
  fileHash                       String
  deduplicationKey               String       @unique
  status                         ImportStatus @default(RECEIVED)
  duplicateAuthorizationGranted Boolean      @default(false)
  warnings                       Json?
  errors                         Json?
  createdAt                      DateTime     @default(now())
  updatedAt                      DateTime     @updatedAt
  validatedAt                    DateTime?

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  bankAccount   BankAccount?   @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  dataSource    DataSource?    @relation(fields: [dataSourceId], references: [id], onDelete: Restrict)
  layoutVersion LayoutVersion? @relation(fields: [layoutVersionId], references: [id], onDelete: Restrict)
  files          ImportedFile[]
  transactions   NormalizedTransaction[]
  ledgerEntries  NormalizedLedgerEntry[]
  evidences      Evidence[]

  @@index([companyId, status, createdAt])
  @@index([fileHash])
}

model ImportedFile {
  id           String   @id @default(uuid())
  importBatchId String
  originalName String
  sanitizedName String
  extension    String
  mimeType     String
  size         Int
  storageKey   String?
  createdAt    DateTime @default(now())

  importBatch ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@index([importBatchId])
}

model NormalizedTransaction {
  id                   String   @id
  companyId            String
  accountId            String
  importBatchId        String
  transactionDate      DateTime @db.Date
  postingDate          DateTime? @db.Date
  amount               Decimal  @db.Decimal(20, 2)
  nature               String
  description          String
  documentNumber       String?
  counterpartyDocument String?
  balanceAfter         Decimal? @db.Decimal(20, 2)
  source               Json
  parsing              Json
  createdAt            DateTime @default(now())

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  account     BankAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  importBatch ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Restrict)

  @@index([companyId, accountId, transactionDate])
  @@index([importBatchId])
}

model NormalizedLedgerEntry {
  id              String   @id
  companyId       String
  ledgerAccountId String
  importBatchId   String
  transactionDate DateTime @db.Date
  amount          Decimal  @db.Decimal(20, 2)
  nature          String
  description     String
  documentNumber  String?
  batchNumber     String?
  source          Json
  createdAt       DateTime @default(now())

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  ledgerAccount LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  importBatch   ImportBatch    @relation(fields: [importBatchId], references: [id], onDelete: Restrict)

  @@index([companyId, ledgerAccountId, transactionDate])
  @@index([importBatchId])
}

model MatchType {
  id          String @id
  name        String
  sourceAType String
  sourceBType String

  profiles ReconciliationProfile[]
  rules    MatchRule[]
}

model MatchRule {
  id                String  @id
  matchTypeId       String
  priority          Int
  cardinality       String
  conditions        Json
  autoConfirm       Boolean @default(false)
  minimumConfidence Float

  matchType MatchType @relation(fields: [matchTypeId], references: [id], onDelete: Cascade)

  @@unique([matchTypeId, priority])
}

model ReconciliationPeriod {
  id        String   @id @default(uuid())
  companyId String
  period    String
  status    String   @default("OPEN")
  closedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  runs    ReconciliationRun[]

  @@unique([companyId, period])
}

model ReconciliationRun {
  id          String               @id @default(uuid())
  companyId   String
  profileId   String
  periodId    String
  status      ReconciliationStatus @default(PREPARING)
  preparerId  String
  reviewerId  String?
  comments    String?
  submittedAt DateTime?
  approvedAt  DateTime?
  closedAt    DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  company     Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  profile     ReconciliationProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  period      ReconciliationPeriod  @relation(fields: [periodId], references: [id], onDelete: Restrict)
  matchGroups MatchGroup[]
  exceptions  ReconciliationException[]
  tasks       WorkflowTask[]
  approvals   Approval[]
  evidences   Evidence[]

  @@index([companyId, status, createdAt])
}

model MatchGroup {
  id                    String   @id
  reconciliationRunId   String
  ruleId                String
  cardinality           String
  confidence            Float
  matchedStatementIds   String[]
  matchedLedgerIds      String[]
  dateDifferenceDays    Int?
  amountDifference      Decimal? @db.Decimal(20, 2)
  descriptionSimilarity Float?
  status                String
  actorId               String?
  createdAt             DateTime @default(now())

  run       ReconciliationRun @relation(fields: [reconciliationRunId], references: [id], onDelete: Cascade)
  evidences Evidence[]

  @@index([reconciliationRunId])
}

model ReconciliationException {
  id                  String          @id
  reconciliationRunId String
  type                String
  status              ExceptionStatus @default(OPEN)
  assignedTo          String?
  dueDate             DateTime?
  resolutionCode      String?
  explanation         String?
  statementId         String?
  ledgerId            String?
  candidateIds        String[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  run       ReconciliationRun @relation(fields: [reconciliationRunId], references: [id], onDelete: Cascade)
  history   ExceptionHistory[]
  evidences Evidence[]

  @@index([reconciliationRunId, status])
  @@index([assignedTo, status])
}

model ExceptionHistory {
  id          String   @id @default(uuid())
  exceptionId String
  action      String
  actorId     String
  before      Json?
  after       Json?
  comment     String?
  occurredAt  DateTime @default(now())

  exception ReconciliationException @relation(fields: [exceptionId], references: [id], onDelete: Cascade)

  @@index([exceptionId, occurredAt])
}

model WorkflowTask {
  id                  String   @id @default(uuid())
  reconciliationRunId String
  type                String
  status              String
  assignedTo          String
  dueDate              DateTime?
  completedAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  run ReconciliationRun @relation(fields: [reconciliationRunId], references: [id], onDelete: Cascade)

  @@index([assignedTo, status])
}

model Approval {
  id                  String   @id @default(uuid())
  reconciliationRunId String
  actorId             String
  decision            String
  comment             String?
  occurredAt          DateTime @default(now())

  run ReconciliationRun @relation(fields: [reconciliationRunId], references: [id], onDelete: Cascade)

  @@index([reconciliationRunId, occurredAt])
}

model Evidence {
  id                  String   @id @default(uuid())
  importBatchId       String?
  reconciliationRunId String?
  matchGroupId        String?
  exceptionId         String?
  type                String
  source              Json
  content             Json?
  createdAt           DateTime @default(now())

  importBatch       ImportBatch?             @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  reconciliationRun ReconciliationRun?       @relation(fields: [reconciliationRunId], references: [id], onDelete: Cascade)
  matchGroup        MatchGroup?               @relation(fields: [matchGroupId], references: [id], onDelete: Cascade)
  exception         ReconciliationException?  @relation(fields: [exceptionId], references: [id], onDelete: Cascade)

  @@index([importBatchId])
  @@index([reconciliationRunId])
}

model CompletedReconciliation {
  id             String   @id
  organizationId String
  companyId      String
  userId         String
  status         String
  period         String
  confirmation   Json
  sourceFiles    Json
  result         Json
  completedAt    DateTime
  expiresAt      DateTime
  processingAttemptId String?
  processingGeneration Int?

  organization ConfigOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company      Company            @relation(fields: [organizationId, companyId], references: [organizationId, id], onDelete: Restrict)
  user         User               @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([organizationId, completedAt])
  @@index([companyId, completedAt])
  @@index([userId, completedAt])
  @@index([expiresAt])
}

model AuditEvent {
  id         String   @id @default(uuid())
  companyId  String?
  entityType String
  entityId   String
  action     String
  actorId    String?
  occurredAt DateTime @default(now())
  before     Json?
  after      Json?
  metadata   Json?

  @@index([entityType, entityId, occurredAt])
  @@index([companyId, occurredAt])
}

model ConfigOrganization {
  id              String       @id
  name            String
  timezone        String
  defaultCurrency String
  status          ActiveStatus
  createdAt       DateTime
  updatedAt       DateTime

  legalEntities         ConfigLegalEntity[]
  bankDirectories       ConfigBankDirectory[]
  banks                 ConfigBank[]
  bankAccounts          ConfigBankAccount[]
  ledgerAccounts        ConfigLedgerAccount[]
  profiles              ConfigProfile[]
  profileVersions       ConfigProfileVersion[]
  accountMappings       ConfigAccountMapping[]
  importMappingVersions ConfigImportMappingVersion[]
  inheritanceNodes      ConfigInheritanceNode[]
  inheritanceOverrides  ConfigInheritanceOverride[]
  simulations           ConfigSimulation[]
  wizardDrafts          ConfigWizardDraft[]
  publishedSnapshots    ConfigPublishedSnapshot[]
  runRecords            ConfigRunRecord[]
  auditEvents           ConfigAuditEvent[]
  memberships          OrganizationMembership[]
  completedReconciliations CompletedReconciliation[]
}

model ConfigLegalEntity {
  id             String
  organizationId String
  legalName      String
  taxId          String
  status         ActiveStatus
  createdAt      DateTime
  updatedAt      DateTime

  organization ConfigOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  companies    Company[]

  @@id([organizationId, id])
  @@unique([organizationId, taxId])
  @@index([organizationId, status])
}

model ConfigBankDirectory {
  id             String
  organizationId String
  name           String
  status         ActiveStatus
  createdAt      DateTime
  updatedAt      DateTime

  organization ConfigOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId, status])
}

model ConfigBank {
  id             String
  organizationId String
  directoryId    String
  code           String
  name           String
  status         ActiveStatus
  createdAt      DateTime
  updatedAt      DateTime

  organization ConfigOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([organizationId, id])
  @@unique([organizationId, directoryId, code])
  @@index([organizationId, directoryId, status])
}

model ConfigBankAccount {
  id                 String
  organizationId     String
  legalEntityId      String
  bankId             String
  agency             String
  account            String
  currency           String
  accountType        AccountType
  status             ActiveStatus
  inactivationReason String?
  inactivatedAt      DateTime?
  effectiveFrom      DateTime     @db.Date
  effectiveTo        DateTime?    @db.Date
  createdAt          DateTime
  updatedAt          DateTime

  organization ConfigOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([organizationId, id])
  @@unique([organizationId, legalEntityId, bankId, agency, account, currency, effectiveFrom])
  @@index([organizationId, legalEntityId, bankId, agency, account, currency, effectiveFrom, effectiveTo])
  @@index([organizationId, status])
}

model ConfigLedgerAccount {
  id             String
  organizationId String
  legalEntityId  String
  code           String
  name           String
  currency       String
  sourceSystem   String
  status         ActiveStatus
  effectiveFrom  DateTime     @db.Date
  effectiveTo    DateTime?    @db.Date
  createdAt      DateTime
  updatedAt      DateTime

  organization ConfigOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([organizationId, id])
  @@unique([organizationId, legalEntityId, sourceSystem, code, effectiveFrom])
  @@index([organizationId, legalEntityId, status])
}

model ConfigProfile {
  id             String
  organizationId String
  legalEntityId  String
  name           String
  description    String?
  status         ActiveStatus
  createdAt      DateTime
  updatedAt      DateTime

  organization ConfigOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([organizationId, id])
  @@unique([organizationId, legalEntityId, name])
  @@index([organizationId, status])
}

model ConfigProfileVersion {
  id               String
  organizationId   String
  profileId        String
  version          Int
  status           ConfigProfileVersionStatus
  configuration    Json
  sourceVersionId  String?
  validationIssues String[]
  effectiveFrom    DateTime                   @db.Date
  effectiveTo      DateTime?                  @db.Date
  createdAt        DateTime
  createdBy        String
  updatedAt        DateTime
  approvedAt       DateTime?
  approvedBy       String?
  publishedAt      DateTime?
  publishedBy      String?

  organization ConfigOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([organizationId, id])
  @@unique([organizationId, profileId, version])
  @@index([organizationId, profileId, status, effectiveFrom, effectiveTo])
}

model ConfigAccountMapping {
  id               String
  organizationId   String
  profileVersionId String
  bankAccountId    String
  ledgerAccountId  String
  priority         Int?
  match            ConfigRoutingMatch?
  conditions       Json?
  fallback         Boolean?
  status           ActiveStatus
  effectiveFrom    DateTime            @db.Date
  effectiveTo      DateTime?           @db.Date
  createdAt        DateTime
  updatedAt        DateTime

  organization ConfigOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([organizationId, id])
  @@unique([organizationId, profileVersionId, bankAccountId, ledgerAccountId, effectiveFrom])
  @@index([organizationId, profileVersionId, status])
}

model ConfigImportMappingVersion {
  id               String
  organizationId   String
  profileVersionId String
  source           ConfigImportMappingSource
  version          Int
  fieldMap         Json
  status           ActiveStatus
  publishedAt      DateTime?
  publishedBy      String?
  effectiveFrom    DateTime                  @db.Date
  effectiveTo      DateTime?                 @db.Date
  createdAt        DateTime
  updatedAt        DateTime

  organization ConfigOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([organizationId, id])
  @@unique([organizationId, profileVersionId, source, version])
  @@index([organizationId, profileVersionId, status])
}

